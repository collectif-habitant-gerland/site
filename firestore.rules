rules_version = '2';

// Règles de sécurité du site « La voix des habitants – Gerland ».
// À copier dans la console Firebase : Firestore Database › Règles › Publier.
//
// - Les habitants (connexion anonyme) peuvent seulement déposer ou modifier LEUR avis.
//   Ils ne peuvent lire ni lister les avis des autres.
// - Seul le compte Google du collectif (le cockpit) lit l'ensemble des données.
service cloud.firestore {
  match /databases/{database}/documents {

    function estAdmin() {
      return request.auth != null
        && request.auth.token.email == 'collectif.habitant.erilia@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function avisValide(d) {
      return d.keys().hasOnly(['uid', 'periode', 'residence', 'notes', 'ameliorations', 'priorite', 'envoyeLe'])
        && d.uid == request.auth.uid
        && d.residence == 'gerland'
        && d.periode is string && d.periode.matches('^[0-9]{4}-[0-9]{2}(-[0-9]{2})?(-[0-9]+)?$')
        && d.notes is map
        && d.notes.keys().hasOnly(['information', 'ecoute', 'acces', 'garages', 'eau', 'chauffage', 'ascenseurs', 'proprete', 'nuisibles', 'etat', 'quartier'])
        && d.ameliorations is list && d.ameliorations.size() <= 12
        && (d.priorite == null || d.priorite is string)
        && d.envoyeLe == request.time
        && periodeOuverte(d.periode);
    }

    // Les avis ne sont acceptés que pour la consultation en cours, et seulement si elle est ouverte.
    function periodeOuverte(p) {
      return !exists(/databases/$(database)/documents/reglages/periode)
        || (get(/databases/$(database)/documents/reglages/periode).data.id == p
          && get(/databases/$(database)/documents/reglages/periode).data.get('statut', 'ouverte') == 'ouverte');
    }

    // Un avis par téléphone et par période : identifiant = « période_identifiant-anonyme ».
    match /avis/{avisId} {
      function estLeSien() {
        return request.auth != null && avisId.matches('^[0-9]{4}-[0-9]{2}(-[0-9]{2})?(-[0-9]+)?_' + request.auth.uid + '$');
      }
      allow get: if estAdmin() || estLeSien();
      allow list: if estAdmin();
      allow create: if estLeSien()
        && avisId == request.resource.data.periode + '_' + request.auth.uid
        && avisValide(request.resource.data);
      allow update: if estLeSien()
        && request.resource.data.periode == resource.data.periode
        && avisValide(request.resource.data);
      allow delete: if estAdmin();
    }

    // Nombre de participants par période (affiché sur l'écran « Merci »).
    // Ne peut augmenter que de 1, et seulement au moment où un nouvel avis est créé.
    match /compteurs/{periode} {
      function nouvelAvis() {
        return request.auth != null
          && existsAfter(/databases/$(database)/documents/avis/$(periode + '_' + request.auth.uid))
          && !exists(/databases/$(database)/documents/avis/$(periode + '_' + request.auth.uid));
      }
      allow get: if true;
      allow list: if estAdmin();
      allow create: if nouvelAvis() && request.resource.data.keys().hasOnly(['total']) && request.resource.data.total == 1;
      allow update: if estAdmin()
        || (nouvelAvis() && request.resource.data.keys().hasOnly(['total']) && request.resource.data.total == resource.data.total + 1);
      allow delete: if estAdmin();
    }

    // Comptes rendus figés (chiffres agrégés, jamais d'avis individuel).
    // Lisibles par qui possède le lien (identifiant aléatoire), jamais listables.
    match /rapports/{rapportId} {
      allow get: if true;
      allow list, write: if estAdmin();
    }

    // Réponses du bailleur, déposées depuis la page du compte rendu. Seul le pilote les lit.
    match /reponses/{reponseId} {
      allow create: if request.resource.data.keys().hasOnly(['rapport', 'nom', 'message', 'contact', 'envoyeLe'])
        && request.resource.data.rapport is string
        && exists(/databases/$(database)/documents/rapports/$(request.resource.data.rapport))
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 120
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 160
        && request.resource.data.envoyeLe == request.time;
      allow read, update, delete: if estAdmin();
    }

    // Réglages publics (période ouverte), modifiables par le seul pilote.
    match /reglages/{reglage} {
      allow get: if true;
      allow list, write: if estAdmin();
    }

    // Historique des consultations (nom, état, dates), réservé au pilote.
    match /periodes/{periodeId} {
      allow read, write: if estAdmin();
    }

    // Signalements : un compteur par problème, visible de tous.
    // Un habitant ne peut compter qu'une fois par problème (sous-collections « votants » et « repares »).
    match /signalements/{probleme} {
      function aVote(sous) {
        return request.auth != null
          && existsAfter(/databases/$(database)/documents/signalements/$(probleme)/$(sous)/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/signalements/$(probleme)/$(sous)/$(request.auth.uid));
      }
      function champs(d) {
        return d.keys().hasOnly(['theme', 'probleme', 'total', 'repares', 'statut', 'premierLe', 'dernierLe'])
          && d.theme is string && d.theme.size() <= 30
          && d.probleme is string && d.probleme.size() <= 140
          && d.total is int && d.total > 0 && d.repares is int && d.repares >= 0
          && d.statut in ['ouvert', 'regle'];
      }
      allow get, list: if true;
      allow create: if aVote('votants') && champs(request.resource.data)
        && request.resource.data.total == 1 && request.resource.data.repares == 0
        && request.resource.data.statut == 'ouvert'
        && request.resource.data.premierLe == request.time
        && request.resource.data.dernierLe == request.time;
      allow update: if estAdmin() || (champs(request.resource.data)
        && request.resource.data.theme == resource.data.theme
        && request.resource.data.probleme == resource.data.probleme
        && request.resource.data.premierLe == resource.data.premierLe
        && request.resource.data.dernierLe == request.time
        && request.resource.data.statut == resource.data.statut
        && ((aVote('votants')
            && request.resource.data.total == resource.data.total + 1
            && request.resource.data.repares == resource.data.repares)
          || (aVote('repares')
            && request.resource.data.repares == resource.data.repares + 1
            && request.resource.data.total == resource.data.total)));
      allow delete: if estAdmin();

      match /{sous}/{uid} {
        allow create: if request.auth != null && uid == request.auth.uid
          && (sous == 'votants' || sous == 'repares')
          && request.resource.data.keys().hasOnly(['le']) && request.resource.data.le == request.time;
        allow get: if estAdmin() || (request.auth != null && uid == request.auth.uid);
        allow list, update, delete: if estAdmin();
      }
    }

    // Avancées obtenues (« Ce qui a changé »), écrites par le pilote, lues par tous.
    match /avancees/{avanceeId} {
      allow get, list: if true;
      allow write: if estAdmin();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
